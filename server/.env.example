# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/doc-dolphin

# Secret used to sign and verify JWTs (use a long random string)
JWT_SECRET=replace-with-a-long-random-secret

# Port the API listens on
PORT=8000

# Base URL of your Ollama server. The vision model must be pulled:
#   ollama pull llava-llama3:8b-v1.1-fp16
OLLAMA_URL=http://localhost:11434
